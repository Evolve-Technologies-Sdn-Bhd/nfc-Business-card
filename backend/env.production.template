# NFC Business Card - Production Environment
# Copy this file to .env and update values for your production server

APP_NAME="NFC Business Card"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_LEVEL=error
LOG_CHANNELS=daily,stack

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfc_business_card_production
DB_USERNAME=nfc_prod_user
DB_PASSWORD=VERY_SECURE_PASSWORD_HERE

# Cache and Session
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Security
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# Payment Gateway Configuration
PAYMENT_DEFAULT_PROVIDER=billplz
PAYMENT_CURRENCY=MYR

# Stripe (International Cards)
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Billplz (Malaysian Payment Gateway - FPX, E-wallets)
BILLPLZ_ENABLED=true
BILLPLZ_API_KEY=your_billplz_api_key
BILLPLZ_COLLECTION_ID=your_collection_id
BILLPLZ_X_SIGNATURE_KEY=your_x_signature_key
BILLPLZ_SANDBOX=false

# Performance
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000

# File Uploads
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=10M

# DEPLOYMENT CHECKLIST:
# 1. Generate new APP_KEY: php artisan key:generate
# 2. Update database credentials
# 3. Update domain URLs
# 4. Configure mail settings
# 5. Set up Redis password
# 6. Update file upload limits in php.ini
# 7. Configure SSL certificates
# 8. Set up monitoring and logging
# 9. Configure backup systems
# 10. Test all functionality
