APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Invoice Configuration
COMPANY_NAME="${APP_NAME}"
COMPANY_LOGO_URL=
COMPANY_ADDRESS="123 Business Street"
COMPANY_CITY="Kuala Lumpur"
COMPANY_STATE="Federal Territory"
COMPANY_POSTAL_CODE="50000"
COMPANY_COUNTRY="Malaysia"
COMPANY_PHONE="+60 12-345-6789"
COMPANY_EMAIL="billing@example.com"
COMPANY_TAX_ID=""
COMPANY_WEBSITE="${APP_URL}"

INVOICE_PAYMENT_DUE_DAYS=30
INVOICE_TAX_RATE=0
INVOICE_CURRENCY="MYR"
INVOICE_NUMBER_PREFIX="INV"

INVOICE_EMAIL_ENABLED=true
INVOICE_EMAIL_FROM_ADDRESS="billing@example.com"
INVOICE_EMAIL_FROM_NAME="Billing Department"

INVOICE_SIGNED_URL_EXPIRATION=60
INVOICE_STORAGE_DISK="local"
INVOICE_STORAGE_PATH="invoices"

INVOICE_QUEUE_ENABLED=true
INVOICE_QUEUE_NAME="invoices"
INVOICE_QUEUE_CONNECTION="database"

VITE_APP_NAME="${APP_NAME}"

# ─── Frontend URL (OAuth callback redirect target) ─────────────────────────
# Production: https://nfcgo.clbgroups.com
# Local:      http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Google OAuth 2.0 Credentials ──────────────────────────────────────────
# Create here: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${APP_URL}/api/auth/google/callback
#   Example: https://nfcgo.clbgroups.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple Sign In (Optional — skip if not needed) ────────────────────────
# Docs: https://developer.apple.com/sign-in-with-apple/
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Windows Dev SSL Workaround for Socialite Guzzle calls ────────────────
# Set to false ONLY on local Windows machines with self-signed cert issues.
# MUST be true or omitted on PRODUCTION.
# CURL_VERIFY_SSL=true
