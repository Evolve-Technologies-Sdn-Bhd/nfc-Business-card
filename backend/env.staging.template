# NFC Business Card - Staging Environment (Alpha/Beta Testing)
# Copy this file to .env and update values for your staging server

APP_NAME="NFC Business Card - Staging"
APP_ENV=staging
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=true
APP_URL=https://staging.yourdomain.com

LOG_LEVEL=debug
LOG_CHANNELS=daily,stack

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfc_business_card_staging
DB_USERNAME=nfc_staging_user
DB_PASSWORD=SECURE_STAGING_PASSWORD_HERE

# Cache and Session
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Frontend URL
FRONTEND_URL=https://staging.yourdomain.com

# Mail Configuration (Use test mail service for staging)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=test@staging.yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Security (Less strict for testing)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Payment Gateway Configuration (Sandbox Mode)
PAYMENT_DEFAULT_PROVIDER=billplz
PAYMENT_CURRENCY=MYR

# Stripe Test Keys (Sandbox)
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_TEST_WEBHOOK_SECRET

# Billplz Sandbox (Malaysian Payment Gateway Testing)
BILLPLZ_ENABLED=true
BILLPLZ_API_KEY=your_billplz_sandbox_api_key
BILLPLZ_COLLECTION_ID=your_sandbox_collection_id
BILLPLZ_X_SIGNATURE_KEY=your_sandbox_x_signature_key
BILLPLZ_SANDBOX=true

# Fiuu / MOLPay Sandbox (Malaysian Payment Gateway Testing)
FIUU_ENABLED=true
FIUU_MERCHANT_ID=your_fiuu_sandbox_merchant_id
FIUU_VERIFY_KEY=your_fiuu_sandbox_verify_key
FIUU_SECRET_KEY=your_fiuu_sandbox_secret_key
FIUU_SANDBOX=true
FIUU_RETURN_URL=https://staging.yourdomain.com/payment/return-url.php
FIUU_NOTIFICATION_URL=https://staging.yourdomain.com/payment/notification-url.php
FIUU_CALLBACK_URL=https://staging.yourdomain.com/payment/callback-url.php

# Performance (Basic settings for testing)
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=64
OPCACHE_MAX_ACCELERATED_FILES=2000

# File Uploads
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=10M

# DEPLOYMENT CHECKLIST FOR STAGING:
# 1. Generate new APP_KEY: php artisan key:generate
# 2. Update database credentials
# 3. Update domain URLs (alpha.yourdomain.com or beta.yourdomain.com)
# 4. Configure test mail service
# 5. Set up basic monitoring
# 6. Configure SSL certificates
# 7. Test all functionality
# 8. Set up error logging
# 9. Configure basic backup
# 10. Document any issues found

# ALPHA TESTING SPECIFIC:
# - Enable detailed logging
# - Use test data
# - Monitor performance
# - Collect user feedback

# BETA TESTING SPECIFIC:
# - Use production-like data
# - Monitor security
# - Test under load
# - Validate user workflows
